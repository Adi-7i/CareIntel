# ─────────────────────────────────────────────────
# CareIntel — Environment Configuration Example
# Copy to .env and fill in real values for local dev.
# NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────

# ── Application ──────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────
# For Supabase: use the direct connection (preferred for persistent backends)
# URL-encode special characters in the password (e.g. @ → %40)
DATABASE_URL=postgresql+asyncpg://postgres:<SUPABASE_DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?ssl=require

# ── Azure Blob Storage ────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=

# Database connection pool tuning (optional; defaults shown)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO_SQL=false

# ── Security ─────────────────────────────────────
# Used for HMAC signing; must be a long random string in production.
SECRET_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING-IN-PRODUCTION

# ── CORS ─────────────────────────────────────────
# Comma-separated origins. Keep restrictive in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Processing & Providers (Phase 11) ────────────
# ── Azure OpenAI (Shared Key) ─────────
AZURE_OPENAI_API_KEY=<your-azure-openai-key>

LLM_PROVIDER=azure_openai
EMBEDDING_PROVIDER=azure_openai
STT_PROVIDER=azure_openai_diarize
TTS_PROVIDER=azure_openai

# ── Azure Document Intelligence ──────────────────
OCR_PROVIDER=azure_document_intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-di-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-di-key>
AZURE_DI_MODEL=prebuilt-layout
OCR_TEMP_WORKSPACE=/tmp/careintel_ocr

LANGUAGE_DETECTION_PROVIDER=demo

TRANSLATION_PROVIDER=demo
TRANSLATION_API_KEY=demo-placeholder
TRANSLATION_ENDPOINT=https://example.invalid

EXTRACTION_PROVIDER=demo

# ── Async Execution & Celery ──────────────────────
REDIS_URL=
CELERY_TASK_DEFAULT_QUEUE=careintel_default
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_HARD_TIME_LIMIT=360
CELERY_STALE_TASK_THRESHOLD_SECONDS=120
