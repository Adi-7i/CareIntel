# ─────────────────────────────────────────────────
# CareIntel — Environment Configuration Example
# Copy to .env and fill in real values for local dev.
# NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────

# ── Application ──────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://careintel:changeme@localhost:5432/careintel_dev

# Database connection pool tuning (optional; defaults shown)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO_SQL=false

# ── Security ─────────────────────────────────────
# Used for HMAC signing; must be a long random string in production.
SECRET_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING-IN-PRODUCTION

# ── CORS ─────────────────────────────────────────
# Comma-separated origins. Keep restrictive in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Processing & Providers (Phase 5) ─────────────
OCR_PROVIDER=demo
OCR_TEMP_WORKSPACE=/tmp/careintel_ocr

STT_PROVIDER=demo

LANGUAGE_DETECTION_PROVIDER=demo

TRANSLATION_PROVIDER=demo
TRANSLATION_API_KEY=demo-placeholder
TRANSLATION_ENDPOINT=https://example.invalid

EXTRACTION_PROVIDER=demo

# ── Async Execution & Celery ──────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_DEFAULT_QUEUE=careintel_default
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_HARD_TIME_LIMIT=360
CELERY_STALE_TASK_THRESHOLD_SECONDS=120
