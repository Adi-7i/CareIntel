# ─────────────────────────────────────────────────────────────────────────────
# CareIntel — Environment Configuration Template
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env with real secrets. NEVER copy .env into a Docker image.
#
# In production or staging, inject secrets through your deployment platform's
# secret manager (Azure Key Vault, AWS Secrets Manager, Kubernetes Secrets,
# etc.) rather than copying a secret-bearing file into the image or runtime.
#
# Variable precedence: process environment > .env > defaults in Settings.
# Run all commands from the repository root so .env is resolved correctly.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# APP_ENV accepts: development | testing | staging | production
# production enforces: APP_DEBUG=false, DATABASE_ECHO_SQL=false, all Azure
#   providers fully configured, REDIS_URL and AZURE_STORAGE_CONNECTION_STRING set.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON list of allowed origins. Empty list disables CORS middleware.
# Example: CORS_ALLOWED_ORIGINS=["https://app.example.com"]
CORS_ALLOWED_ORIGINS=[]

# ── Database ──────────────────────────────────────────────────────────────────
# Required. Must use the asyncpg driver scheme: postgresql+asyncpg://
# postgresql:// and postgres:// schemes are rejected at startup.
# URL-encode reserved characters in credentials (e.g. @ → %40, # → %23).
#
# Direct connection (IPv4/IPv6 must be reachable):
#   DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?ssl=require
#
# Session Pooler (IPv4-compatible, supports DDL and persistent connections):
#   DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?ssl=require

# Database connection pool tuning (optional; defaults shown)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DEPENDENCY_CONNECT_TIMEOUT_SECONDS=10
READINESS_TIMEOUT_SECONDS=30
DATABASE_ECHO_SQL=false

# ── Security ──────────────────────────────────────────────────────────────────
# Both keys are required and must be different high-entropy random strings.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# These must never be the same value. Never commit real secrets.
SECRET_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING
JWT_SECRET_KEY=REPLACE-WITH-A-DIFFERENT-LONG-RANDOM-STRING

# JWT settings (optional; defaults shown)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_ISSUER=careintel
JWT_AUDIENCE=careintel-api

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Required in production. When absent in development, an in-memory FakeBlobProvider
# is used (contents are lost on process restart; not suitable for evidence storage).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=careintel-evidence

# Evidence upload limits (optional; defaults shown)
# EVIDENCE_MAX_FILE_SIZE_BYTES=52428800
# EVIDENCE_SAS_TTL_MINUTES=15
# EVIDENCE_REQUIRE_SCAN_BEFORE_READY=true

# ── Async Execution: Redis and Celery ────────────────────────────────────────
# REDIS_URL is required in production. When absent in development, Celery falls
# back to CELERY_BROKER_URL. The outbox dispatcher requires the same Redis.
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Development-only fallback (ignored when REDIS_URL is set):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=

# Celery task settings (optional; defaults shown)
CELERY_TASK_DEFAULT_QUEUE=careintel_default
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_HARD_TIME_LIMIT=360
CELERY_STALE_TASK_THRESHOLD_SECONDS=120

# ── Provider selectors ────────────────────────────────────────────────────────
# Production requires azure_openai for LLM, embedding, STT, and TTS.
# Development can use demo for all providers (no external calls, no billing).
#
# demo mode: deterministic stubs — suitable for development and unit tests.
# azure_openai: requires AZURE_OPENAI_API_KEY and AZURE_OPENAI_ENDPOINT.
LLM_PROVIDER=demo
EMBEDDING_PROVIDER=demo
STT_PROVIDER=demo
TTS_PROVIDER=demo
OCR_PROVIDER=demo

# Language, translation, and extraction providers — demo only (no production
# external adapter is currently implemented).
LANGUAGE_DETECTION_PROVIDER=demo
TRANSLATION_PROVIDER=demo
EXTRACTION_PROVIDER=demo

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Required when any of the above providers is set to azure_openai.
# In production all AI providers must be azure_openai — demo is rejected.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=

# LLM (structured output-capable deployment)
AZURE_LLM_DEPLOYMENT=YOUR_LLM_DEPLOYMENT
AZURE_LLM_API_VERSION=2024-08-01-preview

# Embeddings (1536-dimensional; schema requires vector(1536))
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Speech-to-text
AZURE_STT_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_STT_DIARIZE_DEPLOYMENT=gpt-4o-transcribe-diarize
AZURE_STT_API_VERSION=2025-03-01-preview
AZURE_STT_DIARIZE_API_VERSION=2025-03-01-preview

# Text-to-speech
AZURE_TTS_DEPLOYMENT=tts-hd
AZURE_TTS_API_VERSION=2025-03-01-preview
AZURE_TTS_VOICE=nova

# ── Azure Document Intelligence ───────────────────────────────────────────────
# Required when OCR_PROVIDER=azure_document_intelligence.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DI_MODEL=prebuilt-layout
OCR_TEMP_WORKSPACE=/tmp/careintel_ocr
