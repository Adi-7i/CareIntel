# ─────────────────────────────────────────────────
# CareIntel — Environment Configuration Example
# Copy to .env and fill in real values for local dev.
# NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────

# ── Application ──────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://careintel:changeme@localhost:5432/careintel_dev

# Database connection pool tuning (optional; defaults shown)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO_SQL=false

# ── Security ─────────────────────────────────────
# Used for HMAC signing; must be a long random string in production.
SECRET_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING-IN-PRODUCTION

# ── CORS ─────────────────────────────────────────
# Comma-separated origins. Keep restrictive in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
